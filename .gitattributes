# Keep the repository in LF, whatever the working copy uses. This is a
# cross-platform project: the engine runs on Windows and the Mac.
* text=auto eol=lf

*.c text
*.py text
*.md text
*.json text

# never munge these
*.wav binary
*.aiff binary
*.mid binary
*.pyd binary

# The guide ships in the zip as Read Me.txt and is opened by whatever
# Windows hands a text file to, so it keeps its CRLF.
*.txt text eol=crlf
